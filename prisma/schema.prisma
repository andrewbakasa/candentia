  // Link to Inventory (Product is being purchased)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // PO Details
  productName      String
  unitPrice        Float
  quantityOrdered  Int
  quantityReceived Int    @default(0) // Tracks goods receipt against the order
  lineTotal        Float

  @@index([purchaseOrderId])
}

model SupplierPayment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  // Payment link to the PO being paid (often multiple POs/Bills are paid in one go, 
  // but for simplicity, linking to one PO or an internal Bill model is common)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  paymentDate DateTime @default(now())
  amount      Float
  reference   String? // Cheque number, bank transfer ID, etc.

  @@index([supplierId])
}

// -----------------------------------------------------------------------------
// --- 1. STRATEGIC GOVERNANCE & BUDGETARY CEILINGS ---
// Tracks high-level fiscal years and total expenditure limits as defined by the 
// Shareholder Meeting (Ref: Guideline 1 of 2025).
// -----------------------------------------------------------------------------

model MM_StrategicPlan {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  year              Int     @unique
  description       String
  totalBudget       Float // HQ-defined maximum expenditure ceiling
  assignedExecutive String? // Accountable officer per Guideline Sec 3.1

  mm_projects MM_Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// -----------------------------------------------------------------------------
// --- 2. PROJECT MANAGEMENT & COST AGGREGATION ---
// Centralized hub for procurement and workshop execution. 
// Implements Project-Centric Procurement: Material Requirements and POs are 
// consolidated at the Project level for bulk ordering efficiency.
// -----------------------------------------------------------------------------

model MM_Project {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  allocatedBudget Float // Approved budget allocation for specific project scope

  workshopId          String      @db.ObjectId
  responsibleWorkshop MM_Workshop @relation(fields: [workshopId], references: [id])
  progress            Int         @default(0) // Percentage completion
  projectManager      String?

  planId String?           @db.ObjectId
  plan   MM_StrategicPlan? @relation(fields: [planId], references: [id])


  // Scheduling & Schedule Variance Engine (SVE)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualEnd      DateTime? // Completion date; null value post-scheduledEnd indicates delay

  activities MM_Activity[]
  status     MM_ProjectStatus @default(PLANNED)

  // Bill of Quantities (BoQ): Master list of everything needed for this project
  materialRequirements MM_MaterialRequirement[]

  // Procurement Portfolio: All POs associated with this project's execution
  purchaseOrders MM_PurchaseOrder[]

  totalActualCost Float    @default(0) // Aggregated spend (Materials + Labor)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// --- 3. MATERIAL PLANNING & REQUISITION TRACKING ---
// Tracks the lifecycle of material needs from initial planning (BoQ) to final 
// procurement. Essential for tracking "missing" vs "ordered" items.
// -----------------------------------------------------------------------------
model MM_MasterMaterial {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  itemCode     String   @unique // The NRZ Part Number
  description  String
  category     String?  // e.g., "Mechanical", "Electrical"
  unitOfMeasure String   @default("units") // e.g., "meters", "kg", "pcs"
  lastKnownCost Float?   // Useful for pre-filling "Estimated Cost"

  // Relations
  requirements MM_MaterialRequirement[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MM_MaterialRequirement {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  projectId String     @db.ObjectId
  project   MM_Project @relation(fields: [projectId], references: [id])

  // NEW RELATION
  materialId String           @db.ObjectId
  material   MM_MasterMaterial @relation(fields: [materialId], references: [id])

  activityLabel String? 
  
  // These remain here because they are "Snapshot" values for a specific project
  quantityRequired  Int
  estimatedUnitCost Float 

  status         MM_MaterialStatus @default(DRAFT)
  poLineItemId   String?           @unique @db.ObjectId
  poLineItem     MM_POLineItem?    @relation(fields: [poLineItemId], references: [id])

  materialProcessDelays MM_ProcessDelay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// -----------------------------------------------------------------------------
// --- 4. EXECUTION & LABOR TRACKING (ACTIVITIES) ---
// Focuses on the engineering timeline, quality control, and labor overhead. 
// -----------------------------------------------------------------------------

model MM_Activity {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String     @db.ObjectId
  project     MM_Project @relation(fields: [projectId], references: [id])
  description String
  supervisor  String?

  // Scheduling & Schedule Variance Engine (SVE)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualEnd      DateTime? // Completion date; null value post-scheduledEnd indicates delay
  progress       Int       @default(0)

  // Quality Assurance & Rework Metrics (Guideline Sec 5.5)
  isRework       Boolean @default(false)
  reworkCost     Float   @default(0)
  varianceReason String? // Narrative for delays (e.g., "Awaiting Funding")

  // Financial Tracking
  allocatedBudget    Float
  actualLaborCost    Float @default(0)
  actualMaterialCost Float @default(0)

  tasks        MM_Task[]
  processDelays    MM_ProcessDelay[]
  dailyplans     MM_DailyPlan[]
  stage        MM_ActivityStage @default(PLANNING)
  requirements String[] // Non-material prerequisites (e.g., Safety Certs)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// --- 5. TASK-LEVEL WORK MANAGEMENT ---
// Granular breakdown of Activity work-steps assigned to staff.
// -----------------------------------------------------------------------------
// // 
// /* How this works for your Teams (Guideline 1 Methodology)
// Standardization: When a project starts, the team picks from the BaseTask list. This ensures that every "Foundation Pour" or "Procurement Audit" uses the same baseline description and benchmark hours.

// Flexibility (User Variation): Once a BaseTask is assigned to an MM_Activity, it becomes an MM_Task. The user can change the title to something specific (e.g., "Foundation Pour - Sector B") without breaking the link to the original "Golden Standard."

// Variance Analysis: Because you kept the baseTaskId, your dashboard can now compare MM_Task.actualHours against BaseTask.benchmarkHours. This is critical for the Financial Performance and Costing Examples mentioned in your guidelines.
//  */

 // 1. The Standardized Blueprint (Non-negotiable Framework)
model BaseTask {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  standardTitle   String   @unique
  standardDesc    String?
  category        String?  // e.g., "Civil", "Electrical", "Procurement"
  
  // Benchmark Metrics (Guideline Sec 6.2)
  benchmarkHours  Float?   // The "Expected" time for this standard task
  requiredSkills  String[] // Skill sets needed for this task
  
  // Relation to instances created from this template
  taskInstances   MM_Task[]
  
  updatedAt DateTime @updatedAt
  createdAt       DateTime @default(now())
}
model MM_Task {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  activityId String      @db.ObjectId
  activity   MM_Activity @relation(fields: [activityId], references: [id])

  // --- Variation Fields ---
  // If user modifies title/desc, it deviates from the BaseTask
  title           String   // Defaulted from BaseTask but editable
  description     String?  // Defaulted from BaseTask but editable
  
  assignedTo  String?
  // Link to the Standard Model
  baseTaskId      String?  @db.ObjectId
  baseTask        BaseTask? @relation(fields: [baseTaskId], references: [id])

  status         TaskStatus @default(PENDING)
  isCompleted    Boolean    @default(false)
  // Added dueDate for SVE tracking
  dueDate        DateTime?
  completionDate DateTime?


  // --- Performance Tracking vs. Benchmark ---
  estimatedHours  Float?   // User-defined for this specific job
  actualHours     Float?   
  
  // Operational Specifics
  materialNotes   String? 
  variationReason String?  // Why did this task deviate from the Base Model?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// -----------------------------------------------------------------------------
// --- 6. PROCUREMENT & FINANCIAL COMMITMENTS ---
// Formal financial documents representing legal commitments to suppliers.
// -----------------------------------------------------------------------------

model MM_PurchaseOrder {
  id       String      @id @default(auto()) @map("_id") @db.ObjectId
  poNumber String      @unique
  status   MM_POStatus @default(AWAITING_FUNDING)

  vendorname String?

  projectId String     @db.ObjectId
  project   MM_Project @relation(fields: [projectId], references: [id])

  totalValue Float           @default(0) // Aggregated cost of all line items
  lineItems  MM_POLineItem[]

  // Audit & Cash Flow Tracking
  createdAt DateTime  @default(now())
  fundedAt  DateTime? // Timestamp for cash outflow trigger
  updatedAt DateTime  @updatedAt
}

model MM_POLineItem {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  poId          String           @db.ObjectId
  purchaseOrder MM_PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  itemCode        String
  description     String
  quantityOrdered Int
  unitPrice       Float
  totalPrice      Float // Logic: quantity * unitPrice

  isReceived Boolean @default(false)

  // Fulfillment Mapping: Closes the loop on Material Requirements
  materialRequirement MM_MaterialRequirement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// --- 7. WORKSHOP INFRASTRUCTURE ---
// -----------------------------------------------------------------------------

model MM_Workshop {
  id       String          @id @default(auto()) @map("_id") @db.ObjectId
  name     String          @unique
  type     MM_WorkshopType @default(MECHANICAL)
  location String?
  capacity Int             @default(0)

  mm_projects MM_Project[]
  dailyplans       MM_DailyPlan[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// -----------------------------------------------------------------------------
// --- 8. ENUMS & CONSTANTS ---
// -----------------------------------------------------------------------------

enum MM_MaterialStatus {
  DRAFT // Identified in Bill of Quantities
  REQUISITIONED // Internal request generated
  PO_ISSUED // Purchase Order confirmed with supplier
  RECEIVED // Item delivered to workshop
  CANCELLED
}

enum MM_POStatus {
  AWAITING_FUNDING
  FUNDED
  RECEIVED
  CANCELLED
}

enum MM_ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum MM_ActivityStage {
  PLANNING
  PROCUREMENT
  ENGINEERING
  QUALITY_ASSURANCE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum MM_WorkshopType {
  MECHANICAL
  ELECTRICAL
  CIVIL
  LOGISTICS
  OPERATIONS
  MANAGEMENT
  PLANNING
}

enum NRZ_UserRole {
  EXECUTIVE
  WORKSHOP_MANAGER
  ENGINEER
  SUPERVISOR
  ARTISAN
}

model MM_DailyPlan {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime // The specific workday
  workshopId  String   @db.ObjectId
  workshop    MM_Workshop @relation(fields: [workshopId], references: [id])  
  // Link to specific activities being worked on today
  activityId  String   @db.ObjectId
  activity    MM_Activity @relation(fields: [activityId], references: [id])
  shift       MM_ShiftType @default(DAY)
  targetOutput String?     // e.g., "Complete disassembly of Unit A"
  actualOutput String?  
  // Daily Resource Snapshot
  manpowerCount Int        @default(0)
  isCompleted   Boolean    @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([date, workshopId, activityId])
}
// Date	2025-10-15
// Workshop	Bulawayo Mechanical (ID: MECH_01)
// Activity	Engine Block Reassembly (ID: ACT_789)
// Target Output	Install all 16 cylinder liners.
// Manpower	4 Artisans, 2 Assistants.
// Enhancement to the Delay Model

// --- Updated Enums ---

enum MM_ShiftType {
  DAY
  NIGHT
  OVERTIME
}
model MM_ProcessDelay {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  type            MM_DelayType  
  // Link to Material if type is MATERIAL_SHORTAGE
  materialReqId   String?  @db.ObjectId
  materialRequest MM_MaterialRequirement? @relation(fields: [materialReqId], references: [id])  
  // Link to Activity (marks if this delay is specifically due to isRework = true)
  activityId      String   @db.ObjectId
  activity        MM_Activity @relation(fields: [activityId], references: [id])
  isReworkTriggered Boolean @default(false) // True if the delay is due to correcting errors  
  description     String   // e.g., "Weld failed X-ray test, requires grinding and re-welding"
  impactHours     Float    @default(0)
  costImpact      Float    @default(0) // Financial cost of the delay (Guideline Sec 5.1)  
  createdAt       DateTime @default(now())
  updatedAt   DateTime     @updatedAt
}
// Type: PROCUREMENT_LAG
// Reason: "O-Rings (Part #NRZ-99) held at customs; PO #8821 awaiting HQ treasury release."
// Impact Days: 5 Days.
// Estimated Loss: $2,500 (Standby labor costs and workshop bay tie-up).


// Updated Enum to reflect your specific delay drivers
enum MM_DelayType {
  REWORK_REQUIRED    // Delay caused by failed QA/Engineering error
  MATERIAL_SHORTAGE  // BoQ items not in stock or PO not funded
  FUNDING_LACK       // Guideline Sec 3.4: Budget ceiling reached
  EQUIPMENT_DOWN     // Workshop infrastructure failure
  LABOR_UNAVAILABLE  // Skill gap or artisan shortage
  SAFETY_HALT          // Work stopped due to an incident or safety audit (Guideline Sec 5.5)
  THIRD_PARTY_REPAIR   // Waiting for external specialist (e.g., Traction Motor rewinding)
  UTILITY_OUTAGE       // ZESA/Power cuts or water shortages stopping heavy machinery
  SPARES_CANNIBALIZATION // Delay while "borrowing" parts from another locomotive (common in rail)
  OTHER
}
