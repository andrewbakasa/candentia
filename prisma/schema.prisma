// Define a clear set of stages for a business project's lifecycle
enum ProjectProgress {
  PROPOSAL       // Initial idea submission (Section 3: Methodology for Teams)
  REVIEW         // Under Executive Committee Review (Section 4: Executive Committee and Shareholder Action)
  ADOPTED        // Approved for implementation
  DEVELOPMENT    // Currently being developed/piloted
  IMPLEMENTATION // Full rollout (Section 4: Implementation)
  COMPLETED      // Project finished
  SHELVED        // Put on hold indefinitely
  ABORTED        // Failed/cancelled
}
model BusinessProjectModel {
  // --- Core Identification & Timestamps ---
  id                   String            @id @default(auto()) @map("_id") @db.ObjectId
  title                String
  description          String?           @db.String
  userId               String            @db.ObjectId // Proposer ID
  // ADD THIS RELATION FIELD (1-to-N relation):
  proposer             User              @relation(fields: [userId], references: [id])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // --- Status & Visibility (Now using Enum for Progress) ---
  progress             ProjectProgress   @default(PROPOSAL) // proposal, review, adopted, implementation, etc.
  visible              Boolean           @default(false)    // Should this be publicly visible?
  active               Boolean           @default(true)     // Is this an active project?
  order                Int?                                 // For manual sorting/display order

  // --- Rating & Engagement ---
  rating               Float?            // Calculated Average User Rating
  viewCount            Int               @default(0)
  projectToUserRatings ProjectToUserRating[]
  comments             ProjectComment[]

  // --- Financial & Evaluation Metrics (Key for Guideline Sections 2 & 5) ---
  // Financial Performance (Section 5: Financial Performance)
  irr                  Float?            // Internal Rate of Return (e.g., 0.15 for 15%)
  npv                  Float?            // Net Present Value ($)
  paybackPeriodYears   Float?            // Expected time until initial investment is recovered
  
  // Risk & Compliance (Section 2 & 5: Resources & Risk, Risk & Compliance)
  riskScore            Float?            // Risk assessment score (e.g., 1-5 scale)
  complianceStatus     String?           // E.g., 'Pending', 'Compliant', 'Non-Compliant'
  
  // Resources & Costing (Section 2: Resources & Risk, Section 6: Costing Examples)
  initialInvestmentUsd Float?          // Total projected upfront cost
  monthlyOpexUsd       Float?          // Projected ongoing operating expenses
  resourceRequirements String?           // Details on human resources, infra needed
  
  // Strategy & Ranking (Section 5: Feasibility and Strategy, Section 3: Project Ranking)
  marketViabilityScore Float?            // Score reflecting market potential (e.g., 1-100)
  projectRanking       Int?              // Final determined rank based on composite evaluation

  // --- Scheduling & Operational Notes ---
  proposedStartDate    DateTime?
  projectedCompletionDate DateTime?
  notes                String?           // Internal/Operational notes
  

  contractModels ContractModel[]
}

model ProjectToUserRating {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  rate                Int
  projectId           String               @db.ObjectId
  project             BusinessProjectModel @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId              String               @db.ObjectId
  user                User                 @relation(fields: [userId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  @@unique([projectId, userId]) // Enforce one rating per user per project
}

model ProjectComment {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  projectId           String               @db.ObjectId
  project             BusinessProjectModel @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId              String               @db.ObjectId // Commenter ID
  user                User                 @relation(fields: [userId], references: [id])
  content             String               @db.String // Added content for the comment
  timestamp           DateTime             @default(now())
  // rate removed as rating is tracked in ProjectToUserRating
}

enum ContractStatus {
  DRAFT            // Initial internal creation
  INTERNAL_REVIEW  // Legal/Internal review phase (Relates to Section 4: Executive Committee Review)
  NEGOTIATION      // In discussion with Counterparty
  ACTIVE           // Fully executed and in force (Relates to Section 4: Implementation)
  EXPIRED          // End date reached
  TERMINATED       // Ended early (e.g., due to Section 5: Risk & Compliance failure)
  ARCHIVED         // Completed or permanently inactive
}

model ContractModel {
  // --- Core Identification & Timestamps ---
  id                   String        @id @default(auto()) @map("_id") @db.ObjectId
  title                String
  contractType         String        // E.g., 'Vendor Agreement', 'Partnership', 'Employment', 'Lease'
  description          String?       @db.String
  
  // ADD RELATION TO PROJECT (Optional 1-to-N relation)
  projectId            String?       @db.ObjectId
  relatedProject       BusinessProjectModel? @relation(fields: [projectId], references: [id])

  //strategy or output....................
  //create interface to related proposed/planned output.....
  //relatedStrategy      StrategyOutput? @relation(fields: [projectId], references: [id])
 
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // --- Status & Visibility (Lifecycle Management) ---
  status               ContractStatus @default(DRAFT)
  version              String        @default("1.0") // Tracking version number
  
  // --- Dates & Duration ---
  effectiveDate        DateTime?     // When the contract legally starts
  expirationDate       DateTime?     // When the contract automatically ends
  autoRenew            Boolean       @default(false) // Does it auto-renew?
  
  // --- Counterparties & Signatures ---
  internalOwnerId      String        @db.ObjectId // User ID of the internal manager/owner
  internalOwner        User          @relation("OwnedContracts", fields: [internalOwnerId], references: [id])
  
  counterpartyName     String        // Name of the external organization/person
  counterpartyContact  String?       // Key contact person at the counterparty
  signedDocumentUrl    String?       // Link to the final signed contract document (Section 3: Standardized Documentation)

  // --- Financial & Compensation ---
  totalValueUsd        Float?        // Total contract value or ceiling amount (Section 2: Financials)
  paymentTerms         String?       // E.g., 'Net 30', 'Quarterly in Advance'
  annualizedCostUsd    Float?        // Recurring annual cost or revenue (Relates to monthlyOpexUsd/annualRevenueEstimateUsd in ProjectModel)

// ADDITIONS FOR REVENUE & PROFIT
  annualRevenueUsd       Float?       // Projected/Actual recurring annual revenue from this contract
  totalContractValueUsd  Float?       // Total aggregate revenue over the full contract term
  profitMarginPercent    Float?       // Calculated Gross Profit Margin (e.g., 0.25 for 25%)
  costAllocationDetails  Json?        // Structured data for detailed cost breakdown
  // --- Risk & Compliance (Aligned with Guidelines Section 5) ---
  riskRating           Float?        // Contract-specific risk score (e.g., 1-5 scale) (Section 5: Risk & Compliance)
  complianceJurisdiction String?     // Governing Law/Jurisdiction
  breachOfContractClause String?     // Summary or reference to breach terms
  
  // --- Obligations & Reminders ---
  obligationsJson      Json?         // Structured data detailing required actions (deliverables, reports, etc.)
  nextReviewDate       DateTime?     // Date for the next internal review (Section 6: Ad-Hoc Meetings)

  // --- Attachments and Notes ---
  notes                String?       @db.String

  contractActivityModels ContractActivityModel[]
}

enum ActivityType {
  MEETING          // Formal scheduled discussion (e.g., Kick-off, Review)
  FOLLOW_UP        // Action item resulting from a meeting or review
  DRAWING_APPROVAL // Submission or approval of technical/design documentation
  RESOURCE_ALLOCATION // Action to secure specific resources (equipment, staff)
  SUPPLIER_ENGAGEMENT // Contact or negotiation with an external party (OEM/vendor)
  DOCUMENT_SUBMISSION // Sending a formal document (e.g., Invoice, Report)
  OTHER            // For general, unclassified tasks
}

enum ActivityStatus {
  SCHEDULED
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  CANCELLED
}

model ContractActivityModel {
  // --- Core Identification & Timestamps ---
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  description         String?          @db.String
  
  // --- Linking to Contract & Responsible Parties ---
  contractId          String           @db.ObjectId // Mandatory link to the parent contract
  contract            ContractModel    @relation(fields: [contractId], references: [id],onDelete: Cascade)
  
  //assignedToId        String           @db.ObjectId // User responsible for this action/follow-up
  //assignedTo          User             @relation(fields: [assignedToId], references: [id])
  responsiblePersons String
  
  createdByUserId     String           @db.ObjectId // User who created the activity record
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // --- Activity Details ---
  activityType                ActivityType     @default(FOLLOW_UP)
  status              ActivityStatus   @default(SCHEDULED)
  
  // --- Scheduling & Deadlines ---
  dueDate             DateTime         // Target completion date for the activity
  completedAt         DateTime?        // Actual completion date
  
  // --- Resources & Documentation ---
  // Tracks resources committed or allocated by this activity
  resourceDetails     String?          // E.g., "3 engineers for 40 hours," "Purchase Order #1234"
  
  // Tracks specific documentation related to the activity (e.g., meeting minutes, drawing file reference)
  documentReferenceUrl String?          // Link to the specific document (Minutes, Drawing file)

  // --- Source/Outcome Notes ---
  outcomeNotes        String?          @db.String // Summary of the outcome or what was agreed upon
}


// ----------------------------------------------------
// ENUMS (Status, Roles, Scores)
// ----------------------------------------------------

// Defines the standardized scoring scale
enum ScoreValue {
  LOW
  MEDIUM
  HIGH
}

// Defines the status of a proposal (Milestones M1, M2, M3)
enum ProposalStatus {
  DRAFT          // M1.1: Concept Submission (Editable)
  REVIEW_PENDING   // M1.2: Leadership Review
  COMMENT_OPEN     // M1.3: Collaborative Input
  VOTING_OPEN      // M2.2: Voting Opens
  VOTING_CLOSED    // M2.4: Voting Closes & Tally
  APPROVED       // M3.2: Formal Decision Communication
  REJECTED       // M3.2: Formal Decision Communication
}

// Defines the possible vote outcomes
enum VoteType {
  YES
  NO
  ABSTAIN
}

// Defines user roles based on Guideline 1 of 2025
enum UserRole {
  SHAREHOLDER       // Can vote on final proposals (M2.2)
  EXECUTIVE_COMMITTEE // Reviews proposals (M1.2, M3.1)
  TEAM_MEMBER       // Can submit proposals and provide comments
}

// ----------------------------------------------------
// 2. STRATEGY (PROPOSAL) & STAGE MANAGEMENT
// ----------------------------------------------------

model Strategy {
  id                    String             @id @default(auto()) @map("_id") @db.ObjectId
  title                 String
  content               String          // Detailed analysis, financials, operations, etc.
  year                  String?         // Added the 'year' field from your updated model
  status                ProposalStatus   @default(DRAFT)
  submissionDate        DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Voting period details
  votingStart           DateTime?
  votingEnd             DateTime?
 
  // Results
  totalVotesYes         Int              @default(0)
  totalVotesNo          Int              @default(0)
  averageStrategicScore Float?          // Calculated score based on StrategicAttributes and Criteria weights

  // Relationships
  authorId              String           @db.ObjectId
  author                User             @relation(fields: [authorId], references: [id])
  comments              StrategyComment[]
  votes                 StrategyVote[]
  strategicAttributes   StrategicAttribute[]
  goals                 StrategyGoal[]    // RBM Relationship: One Strategy can have multiple Goals

  @@index([authorId])
  @@index([status]) // Optimize lookup by status
}

// ----------------------------------------------------
// RBM MODELS (Goal, Outcome, Output)
// These models implement the RBM results chain: Strategy -> Goal -> Outcome -> Output
// ----------------------------------------------------

// 1. StrategyGoal (Long-Term/High-Level Impact)
model StrategyGoal {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  title           String            // e.g., "Achieve significant market share in the B2G sector"
  description     String?
  targetYear      Int               // e.g., 2027

  // Relationship to the Strategy
  strategyId      String            @db.ObjectId
  strategy        Strategy          @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  // RBM Relationship: One Goal can have multiple Outcomes
  outcomes        StrategyOutcome[]

  @@index([strategyId])
}

// 2. StrategyOutcome (Medium-Term/Behavioral Change or Effect)
model StrategyOutcome {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  title           String           // e.g., "Improve supplier relationship and perception"
  description     String?
  kpi             String?          // Key Performance Indicator (KPI) to track success, e.g., "Number of unsolicited RFQs received per quarter"

  // Relationship to the Goal
  goalId          String           @db.ObjectId
  goal            StrategyGoal     @relation(fields: [goalId], references: [id],onDelete: Cascade)

  // RBM Relationship: One Outcome is achieved through multiple Outputs
  outputs         StrategyOutput[]

  @@index([goalId])
}

// 3. StrategyOutput (The Deliverable)
model StrategyOutput {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  title           String             // e.g., "NRZ Vendor Registration Complete"
  description     String?

  
  responsible     String? 
 // responsibleId   String?            @db.ObjectId // ID of the User primarily responsible for this deliverable
 // responsibleUser     User?              @relation("OutputResponsible", fields: [responsibleId], references: [id])
  costEstimate    Float?
  isCompleted     Boolean            @default(false)
  completionDate  DateTime?          // Date the Output was finalized

  // Relationship to the Outcome
  outcomeId       String             @db.ObjectId
  outcome         StrategyOutcome    @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  // NEW: Relationship to the activities/action plan needed to achieve this output
  activities      StrategyActivity[]

  createdAt           DateTime         @default(now())
  updatedAt       DateTime @updatedAt

  @@index([outcomeId])
 // @@index([responsibleId])
}
// ----------------------------------------------------
// 4. IMPLEMENTATION MANAGEMENT (Action Plan, Timeline, Progress)
// StrategyOutput -> StrategyActivity
// ----------------------------------------------------

// StrategyActivity (The Action Plan / Rollout Task)
// Represents a granular step or task required to complete a StrategyOutput (deliverable).
model StrategyActivity {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  title             String           // e.g., "Draft RFP for NRZ Vendor Registration"
  description       String?
  startDate         DateTime?
  dueDate           DateTime?        // Scheduled completion time (important for DUE/OVERDUE tracking)
  completionDate    DateTime?
  status            ActivityStatus   @default(SCHEDULED)
  progressPercent   Int              @default(0) @map("progress_percent") // 0-100

  // --- Activity Details ---
  activityType                ActivityType     @default(FOLLOW_UP)
  

  // Relationship to the StrategyOutput (Deliverable)
  outputId          String           @db.ObjectId
  output            StrategyOutput   @relation(fields: [outputId], references: [id], onDelete: Cascade)
  createdAt           DateTime         @default(now())
  updatedAt       DateTime @updatedAt
  @@index([outputId])
  //@@index([responsibleUserId])
  @@index([status]) // Allows for easy querying of TO_DO, IN_PROGRESS, OVERDUE tasks
}
// ----------------------------------------------------
// SUPPORT MODELS (Comments, Votes, Criteria)
// ----------------------------------------------------

// 3. COMMENTS AND SUGGESTIONS (M1.3)
model StrategyComment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  content         String
  createdAt       DateTime @default(now())
  likesCount      Int      @default(0)

  // Foreign Keys
  proposalId      String   @db.ObjectId
  authorId        String   @db.ObjectId

  // Relationships
  proposal        Strategy @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  author          User     @relation(fields: [authorId], references: [id])

  @@index([proposalId])
  @@index([authorId])
}

// 4. VOTING MECHANISM (M2.2)
model StrategyVote {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  type            VoteType
  timestamp       DateTime @default(now())

  updatedAt       DateTime @updatedAt
  // Foreign Keys
  voterId         String   @db.ObjectId
  proposalId      String   @db.ObjectId

  // Relationships
  voter           User     @relation(fields: [voterId], references: [id],onDelete: Cascade)
  proposal        Strategy @relation(fields: [proposalId], references: [id],onDelete: Cascade)

  // Ensures a user can only vote once per proposal
  @@unique([voterId, proposalId])
  @@index([proposalId])
}

// 5. STRATEGIC CRITERIA & EVALUATION

// Model for the criteria themselves (e.g., Financial Performance, Risk)
// Allows for dynamic criteria management and weighting
model StrategyCriterion {
  id                    String               @id @default(auto()) @map("_id") @db.ObjectId
  name                  String               @unique // e.g., "Financial Performance"
  description           String?              // Guidance on evaluation
  weight                Int                  @default(1) // Allows for weighted scoring (e.g., Financials weight 3)

  // Relationship to link to the evaluations
  strategicAttributes   StrategicAttribute[]
}

// Model for the actual evaluation score of a proposal against a criterion
model StrategicAttribute {
  id                    String               @id @default(auto()) @map("_id") @db.ObjectId

  // Link to the Criterion
  criterionId            String   @db.ObjectId
  criterion             StrategyCriterion    @relation(fields: [criterionId], references: [id],onDelete: Cascade)

  scoreValue            ScoreValue          // The score given (e.g., HIGH)
  justification         String              // Detailed comments or justification for the score

  // Who performed the evaluation?
  evaluatorId           String?             // This could link back to User.id for audit purposes

  // Link to the Proposal
  proposalId             String   @db.ObjectId
  proposal              Strategy             @relation(fields: [proposalId], references: [id],onDelete: Cascade)

  // Ensures only one score for a specific criterion on a specific proposal
  @@unique([proposalId, criterionId])
  @@index([proposalId])
  @@index([criterionId])
}